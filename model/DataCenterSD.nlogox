  <systemDynamics dt="0.125">
    <stock name="contracted-mw" allowNegative="false" x="130" y="60">0</stock>
    <stock name="grid-mw" allowNegative="false" x="430" y="60">0</stock>
    <stock name="energized-mw" allowNegative="false" x="730" y="60">0</stock>
    <stock name="water-capacity" allowNegative="false" x="130" y="380">w0</stock>
    <stock name="net-fiscal" allowNegative="true" x="130" y="580">0</stock>
    <stock name="population" allowNegative="false" x="1270" y="300">p0</stock>
    <stock name="opposition" allowNegative="false" x="1270" y="540">o0</stock>
    <stock name="cumulative-nb" allowNegative="true" x="130" y="790">0</stock>
    <reservoir x="40" y="130"></reservoir>
    <reservoir x="340" y="130"></reservoir>
    <reservoir x="640" y="130"></reservoir>
    <reservoir x="40" y="450"></reservoir>
    <reservoir x="40" y="650"></reservoir>
    <reservoir x="1180" y="370"></reservoir>
    <reservoir x="1180" y="610"></reservoir>
    <reservoir x="40" y="860"></reservoir>
    <rate name="sign-rate" bivalent="false" startFigure="8" endFigure="0">mn (size-mw / t-sign * permit-factor) ((mx 0 (size-mw - contracted-mw)) / dt-step)</rate>
    <rate name="grid-build" bivalent="false" startFigure="9" endFigure="1">(contracted-mw - grid-mw) / d-grid</rate>
    <rate name="energize" bivalent="false" startFigure="10" endFigure="2">energize-rate</rate>
    <rate name="water-expansion" bivalent="false" startFigure="11" endFigure="3">ifelse-value (stress-struct &gt; ws-trigger and water-capacity &lt; water-cap) [(mn (mx 0 (water-target - water-capacity)) (water-cap - water-capacity)) / d-water] [0]</rate>
    <rate name="fiscal-flow" bivalent="true" startFigure="12" endFigure="4">rev-net - relief-cash - cost-svc - cost-pop</rate>
    <rate name="pop-growth" bivalent="false" startFigure="13" endFigure="5">population * g-pop * (mx 0 (1 - s-hm * housing-excess)) + persons-per-mw * energize-rate</rate>
    <rate name="opp-flow" bivalent="true" startFigure="14" endFigure="6">(opp-target - opposition) / tau-o</rate>
    <rate name="nb-flow" bivalent="true" startFigure="15" endFigure="7">net-benefit</rate>
    <converter name="time-year" x="1100" y="60">ticks</converter>
    <converter name="p-base" x="1270" y="60">p0 * (1 + g-pop * dt-step) ^ (time-year / dt-step)</converter>
    <converter name="h-ref" x="1440" y="60">(p-base / p0) ^ hou-elast</converter>
    <converter name="construction-gw" x="400" y="190">(contracted-mw - energized-mw) / 1000</converter>
    <converter name="permit-factor" x="60" y="190">ifelse-value links-on? [clip ((1 - s-perm * opposition) / (1 - s-perm * o0)) 0 m-max] [1]</converter>
    <converter name="energize-rate" x="910" y="190">(grid-mw - energized-mw) / tau-energize</converter>
    <converter name="wi" x="570" y="380">ifelse-value (cooling = "evap") [wi-evap] [wi-closed]</converter>
    <converter name="ratepayer-share" x="230" y="270">ifelse-value (payer = "ratepayer") [share-ratepayer-pays] [share-dc-pays]</converter>
    <converter name="capex-annual" x="400" y="270">grid-mw * cost-per-mw * carry-charge</converter>
    <converter name="rate-index" x="570" y="270">1 + ratepayer-share * capex-annual / resid-rev-base</converter>
    <converter name="water-demand-base" x="740" y="380">water-base0 * population / p0</converter>
    <converter name="water-demand" x="910" y="380">water-demand-base + energized-mw * wi</converter>
    <converter name="drought-on" x="60" y="470">ifelse-value (drought? and time-year &gt;= drought-start and time-year &lt; drought-start + drought-duration) [1] [0]</converter>
    <converter name="effective-capacity" x="230" y="470">water-capacity * (1 - drought-severity * drought-on)</converter>
    <converter name="water-stress" x="400" y="470">water-demand / effective-capacity</converter>
    <converter name="stress-struct" x="570" y="470">water-demand / water-capacity</converter>
    <converter name="water-target" x="740" y="470">water-demand / ws-target</converter>
    <converter name="housing-index" x="1100" y="190">(population / p0) ^ hou-elast * (1 + k-prox * energized-mw / 1000)</converter>
    <converter name="housing-excess" x="1270" y="190">housing-index / h-ref - 1</converter>
    <converter name="persons-per-mw" x="1440" y="190">jobs-per-mw * (1 + job-multiplier) * newhh-per-job * hh-size</converter>
    <converter name="abatement" x="400" y="580">abate0 * (mx 0 (1 - time-year / t-abate))</converter>
    <converter name="rev-net" x="570" y="580">rev-per-mw * energized-mw * (1 - abatement)</converter>
    <converter name="relief-cash" x="740" y="580">relief-share * rev-net</converter>
    <converter name="relief-index" x="910" y="580">relief-cash / levy-base</converter>
    <converter name="cost-svc" x="400" y="660">svc-cost-per-mw * energized-mw</converter>
    <converter name="pop-dc" x="570" y="660">population - p-base</converter>
    <converter name="cost-pop" x="740" y="660">percap-cost * pop-dc / 1000000</converter>
    <converter name="opp-driver" x="1100" y="660">d-open0 + a-c * construction-gw + a-w * (mx 0 (water-stress - ws-opp)) + a-e * (rate-index - 1) / 0.1 + a-h * housing-excess - a-r * relief-index</converter>
    <converter name="opp-target" x="1270" y="660">(mx 0 opp-driver) / (1 + (mx 0 opp-driver))</converter>
    <converter name="households" x="1440" y="330">population / hh-size</converter>
    <converter name="fiscal-hh" x="400" y="790">1000000 * (rev-net - cost-svc - cost-pop) / households</converter>
    <converter name="elec-hh" x="570" y="790">(rate-index - 1) * elec-price / 100 * hh-kwh</converter>
    <converter name="house-hh" x="740" y="790">housing-excess * house-cost-base</converter>
    <converter name="stress-base-eff" x="910" y="880">water-base0 * p-base / p0 / (w0 * (1 - drought-severity * drought-on))</converter>
    <converter name="water-hh" x="910" y="790">shortage-cost * ((mx 0 (water-stress - 1)) - (mx 0 (stress-base-eff - 1)))</converter>
    <converter name="ql-hh" x="1100" y="790">ql-cost * (energized-mw / 1000) * opposition</converter>
    <converter name="net-benefit" x="230" y="880">fiscal-hh - elec-hh - house-hh - water-hh - ql-hh</converter>
    <converter name="dt-step" x="1440" y="130">0.125</converter>
