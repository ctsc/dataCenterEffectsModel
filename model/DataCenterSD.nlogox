<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="false">
  <code>; Generated by model/build_nlogox.py from notes/model_spec.md. Do not edit by hand; edit the generator.

to setup
  clear-all
  system-dynamics-setup
  update-plots
end

to go
  if ticks &gt;= 20 [ stop ]
  system-dynamics-go
  update-plots
end

to-report mx [a b]
  report ifelse-value (a &gt; b) [a] [b]
end

to-report mn [a b]
  report ifelse-value (a &lt; b) [a] [b]
end

to-report clip [x lo hi]
  report mx lo (mn x hi)
end

to presets-sail
  set size-mw size-sail
end

to presets-sail-bridgeport-pegasus
  set size-mw size-sail + size-bridgeport + size-pegasus
end

to presets-all-four
  set size-mw size-sail + size-bridgeport + size-pegasus + size-peach
end
</code>
